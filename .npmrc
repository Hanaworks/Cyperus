# 依赖安装策略
#
# 注意：不要设置 ignore-scripts=true。
# pnpm 10+ 默认就不执行任何依赖的构建脚本（安全默认值），
# 而 ignore-scripts=true 会连 onlyBuiltDependencies 白名单里的包一起禁掉，
# 导致 esbuild / @biomejs/biome / @tauri-apps/cli 装出来是不可用的空壳。
# 正确做法：在 pnpm-workspace.yaml 的 onlyBuiltDependencies 中显式放行。

# peer 依赖不满足时仅警告，不阻断安装。
# 理由：Tauri / Vue 生态的 peer 声明常滞后于实际兼容版本，
# 由 typecheck + 运行期验证兜底，而不是让安装失败。
strict-peer-dependencies=false

# 使用隔离的 node_modules，避免提升造成的隐式依赖。
node-linker=isolated
shamefully-hoist=false
