# 禁用依赖的生命周期脚本，降低供应链风险。
# 需要构建脚本的包（esbuild / @biomejs/biome / @tauri-apps/cli）在安装时
# 使用 `pnpm add --allow-build=<pkg>` 或 pnpm 的 onlyBuiltDependencies 白名单放行。
ignore-scripts=true

# peer 依赖不满足时仅警告，不阻断安装。
# 理由：Tauri / Vue 生态的 peer 声明常滞后于实际兼容版本，
# 由 typecheck + 运行期验证兜底，而不是让安装失败。
strict-peer-dependencies=false

# 使用 worktree 级别的孤立 node_modules，避免提升造成的隐式依赖。
node-linker=isolated
shamefully-hoist=false
